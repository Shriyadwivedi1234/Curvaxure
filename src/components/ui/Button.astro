---
import type { HTMLAttributes } from 'astro/types';
interface Props extends HTMLAttributes<'a'> {
  href: string;
  variant?: 'primary' | 'secondary' | 'accent';
  class?: string;
}
const { href, variant = 'primary', class: extra = '', ...rest } = Astro.props;
const styles = {
  primary: 'bg-ink text-white border-ink shadow-[0_12px_26px_-10px_rgb(23_22_26/0.7)] hover:shadow-[0_0_30px_rgb(217_196_142/0.55)]',
  secondary: 'bg-white text-ink border-ink hover:shadow-[0_0_24px_rgb(217_196_142/0.4)]',
  accent: 'bg-champagne text-ink border-champagne hover:shadow-[0_0_30px_rgb(217_196_142/0.6)]',
}[variant];
---
<a
  {...rest}
  href={href}
  class:list={[
    'inline-flex items-center justify-center gap-2 rounded-full border-[1.5px] px-6 py-3.5 text-[15px] font-semibold transition-transform hover:-translate-y-0.5',
    styles,
    extra,
  ]}
><slot /></a>
