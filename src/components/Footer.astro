---
import { site, footerLinks } from '@/config/site';
---
<footer class="mt-0 rounded-t-[44px] bg-ink pb-7 pt-16 text-sm text-mist">
  <div class="mx-auto grid max-w-6xl gap-10 px-5 md:grid-cols-4">
    <div>
      <p class="font-display text-[22px] font-extrabold text-white">{site.name}</p>
      <p class="mt-3 max-w-[24em]">Turn fragmented data into better decisions and shape the direction of your growth.</p>
    </div>
    {Object.entries(footerLinks).map(([group, links]) => (
      <nav aria-label={group}>
        <h2 class="label !font-label !text-xs !tracking-[0.06em] text-champagne">{group}</h2>
        <ul class="mt-3 space-y-1">{links.map((l) => <li><a href={l.href} class="block py-1 hover:text-white">{l.label}</a></li>)}</ul>
      </nav>
    ))}
  </div>
  <div class="mx-auto mt-10 flex max-w-6xl flex-wrap justify-between gap-2 border-t border-pan2 px-5 pt-5 text-xs">
    <span>© {new Date().getFullYear()} {site.name}. Demo dashboards use dummy data.</span>
    <span>Microsoft, Power BI and Excel are trademarks of Microsoft. Curvaxure is independent.</span>
  </div>
</footer>
