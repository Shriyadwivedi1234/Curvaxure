---
import Logo from '@/components/ui/Logo.astro';
import { site, footerLinks } from '@/config/site';
---
<footer class="bg-ink pb-8 pt-16 text-mist">
  <div class="container-page">
    <div class="grid grid-cols-2 gap-10 md:grid-cols-[minmax(0,2fr)_repeat(3,minmax(0,1fr))]">
      <div class="col-span-2 md:col-span-1">
        <Logo tone="light" />
        <p class="mt-4 max-w-[26em] text-[14px] leading-[1.7]">
          Power BI dashboards and reporting for growing businesses.
        </p>
        <a
          href={`mailto:${site.contactEmail}`}
          class="mt-4 inline-block text-[14px] text-paper transition-colors duration-150 hover:text-champagne"
        >
          {site.contactEmail}
        </a>
      </div>

      {Object.entries(footerLinks).map(([group, links]) => (
        <nav aria-label={group}>
          <h2 class="text-[12px] font-medium text-mist">{group}</h2>
          <ul class="mt-4 space-y-1">
            {links.map((link) => (
              <li>
                <a
                  href={link.href}
                  class="block py-1.5 text-[14px] leading-[1.4] transition-colors duration-150 hover:text-paper"
                >
                  {link.label}
                </a>
              </li>
            ))}
          </ul>
        </nav>
      ))}
    </div>

    <div class="mt-12 border-t border-line-dark pt-6">
      <div class="flex flex-wrap items-center justify-between gap-3 text-[12px]">
        <p>© {new Date().getFullYear()} Curvaxure. Demo dashboards use dummy data.</p>
        <div class="flex gap-5">
          <a href="/privacy-policy" class="transition-colors hover:text-paper">Privacy</a>
          <a href="/terms-and-conditions" class="transition-colors hover:text-paper">Terms</a>
        </div>
      </div>
      <p class="mt-3 text-[11px] leading-[1.6]">
        Microsoft, Power BI and Excel are trademarks of Microsoft. Curvaxure is independent.
      </p>
    </div>
  </div>
</footer>
