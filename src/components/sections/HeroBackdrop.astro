---
// Decorative tech backdrop: fine grid, dashed data lines, nodes, coordinate labels.
const fade = 'radial-gradient(ellipse 75% 70% at 50% 40%, #000 30%, transparent 100%)';
const nodes = [
  { x: 700, y: 620, t: 'x:412 y:88' }, { x: 820, y: 230, t: 'x:640 y:214' },
  { x: 1180, y: 440, t: 'x:905 y:161' }, { x: 520, y: 450, t: 'x:310 y:128' },
];
---
<div class="pointer-events-none absolute inset-0" aria-hidden="true">
  <div class="absolute inset-0" style={`background-image:linear-gradient(rgb(23 22 26/.07) 1px,transparent 1px),linear-gradient(90deg,rgb(23 22 26/.07) 1px,transparent 1px);background-size:56px 56px;-webkit-mask-image:${fade};mask-image:${fade}`}></div>
  <svg class="absolute inset-0 h-full w-full" viewBox="0 0 1440 820" preserveAspectRatio="xMidYMid slice" style={`-webkit-mask-image:${fade};mask-image:${fade}`}>
    <g fill="none" stroke="#17161A" stroke-opacity=".2" stroke-width="1.2" stroke-dasharray="3 7">
      <path d="M-20 640C260 580 380 720 700 620S1180 440 1460 540" />
      <path d="M-20 250C300 320 520 170 820 230S1200 330 1460 190" />
      <path d="M-20 430C200 400 300 480 520 450" />
    </g>
    {nodes.map((n) => (
      <>
        <circle cx={n.x} cy={n.y} r="5" fill="#EEEDEA" stroke="#17161A" stroke-opacity=".35" stroke-width="1.5" />
        <text x={n.x + 10} y={n.y + 26} font-size="11" fill="#17161A" fill-opacity=".45" font-family="Space Grotesk Variable, sans-serif">{n.t}</text>
      </>
    ))}
  </svg>
  <span class="label absolute left-6 top-5 hidden text-ink/50 md:block">curvaxure / live_sample</span>
  <span class="label absolute bottom-5 right-6 hidden text-ink/50 md:block">illustrative · dummy data</span>
</div>
