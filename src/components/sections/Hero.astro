---
import Button from '@/components/ui/Button.astro';
import DashboardPreview from '@/components/sections/DashboardPreview.astro';
---
<section class="relative">
  <div class="container-page grid items-center gap-12 pb-20 pt-12 xl:grid-cols-[minmax(0,5fr)_minmax(0,7fr)] xl:gap-16 xl:pb-20 xl:pt-16">
    <div class="enter min-w-0 max-w-[34em]">
      <p class="eyebrow">Data analytics for growing businesses</p>

      <h1 class="mt-5 text-[clamp(46px,5.2vw,60px)] leading-[0.98] tracking-[-0.035em]">
        <span class="block">See the numbers.</span>
        <span class="block">Make the call.</span>
      </h1>

      <p class="mt-6 text-[17px] leading-[1.65] text-slate">
        We connect the data scattered across your tools into clear Power BI dashboards,
        then help your team decide where to focus.
      </p>

      <div class="mt-8 flex flex-wrap gap-3">
        <Button href="/book-consultation?source=hero" class="w-full sm:w-auto">Request a data assessment</Button>
        <Button href="#console" variant="secondary" class="w-full sm:w-auto">See a sample decision</Button>
      </div>

      <div class="mt-10 border-t border-line pt-4">
        <p class="text-[13px] leading-[1.6] text-slate">
          Works with Excel, ERP, CRM, accounting, ads and e-commerce data.
        </p>
      </div>
    </div>

    <div class="enter enter-late min-w-0">
      <DashboardPreview />
    </div>
  </div>
</section>
