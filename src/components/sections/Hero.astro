---
import Button from '@/components/ui/Button.astro';
import HeroBackdrop from '@/components/sections/HeroBackdrop.astro';
import DashboardPreview from '@/components/sections/DashboardPreview.astro';
---
<section class="relative overflow-hidden text-center">
  <HeroBackdrop />
  <div class="relative z-10 mx-auto max-w-6xl px-5 pb-24 pt-14">
    <span class="label inline-flex items-center gap-2 rounded-full border-[1.5px] border-ink bg-white px-4 py-1.5">
      <i class="h-[9px] w-[9px] rounded-full bg-champagne [animation:pulse-ring_2.4s_infinite]"></i>Decision support for growing teams
    </span>
    <h1 class="mx-auto mt-6 max-w-[9.5em] text-[clamp(46px,8.4vw,104px)]">
      Curve your growth. Shape <mark class="rounded-md bg-transparent px-[0.06em] text-inherit [background-image:linear-gradient(transparent_64%,rgb(217_196_142/.32)_64%_92%,transparent_92%)]">what's next.</mark>
    </h1>
    <p class="mx-auto mb-8 mt-6 max-w-[33em] text-[19px] text-slate">
      We turn fragmented data from your tools into clear dashboards and better decisions, so you can see what is moving and act with confidence.
    </p>
    <div class="flex flex-wrap justify-center gap-3">
      <Button href="/book-consultation?source=hero">Request a data assessment →</Button>
      <Button href="#console" variant="secondary">See sample dashboards</Button>
    </div>
    <p class="label mt-8 text-slate">Excel · ERP · CRM · Accounting · Ads · E-commerce · Operations</p>
    <DashboardPreview />
  </div>
</section>
