---
// Illustrative dashboard + agent concept. All values are dummy data.
const kpis = [
  { l: 'Revenue', v: '1.24M', d: '▲ 4.2%', alert: false },
  { l: 'Gross margin', v: '31.8%', d: '▼ 1.6 pts', alert: true },
  { l: 'Orders', v: '8,420', d: '▲ 2.1%', alert: false },
  { l: 'CAC', v: '42', d: '▲ 9%', alert: true },
];
const pts = [[8,84],[34,78],[60,80],[86,66],[112,62],[138,70],[164,52],[190,56],[216,44],[242,40],[268,34],[292,30]];
const line = 'M' + pts.map((p) => p.join(' ')).join('L');
const channels = [
  { n: 'A', w: 150, alert: false }, { n: 'B', w: 120, alert: false },
  { n: 'C', w: 52, alert: true }, { n: 'D', w: 100, alert: false },
];
const steps = [
  { i: '✓', t: 'Connected 6 sources', warn: false },
  { i: '✓', t: 'Matched and cleaned 3 mismatched fields', warn: false },
  { i: '!', t: 'Margin dipped in channel C this month', warn: true },
  { i: '→', t: 'Drafted a review note for the next meeting', warn: false },
];
---
<div class="relative mx-auto mt-14 max-w-[1020px] sheen-sweep overflow-hidden rounded-[28px] bg-gradient-to-br from-[#2d2c32] to-[#1e1d22] text-left text-white shadow-[0_40px_70px_-30px_rgb(23_22_26/0.7)]" aria-hidden="true">
  <div class="label flex items-center border-b border-white/10 px-[18px] py-3 text-mist">
    <span>Sales &amp; margin overview</span><span class="ml-auto">Sample dashboard · dummy data</span>
  </div>
  <div class="grid lg:grid-cols-[1.75fr_1fr]">
    <div class="grid gap-3 p-[18px]">
      <div class="flex flex-wrap gap-2 text-xs text-mist">
        {['Year: 2026', 'Region: All', 'Channel: All'].map((c) => <span class="rounded-full border border-white/15 px-3 py-1">{c}</span>)}
      </div>
      <div class="grid grid-cols-2 gap-2.5 sm:grid-cols-4">
        {kpis.map((k) => (
          <div class="glass-dark rounded-2xl p-3">
            <small class="block text-[11px] text-mist">{k.l}</small>
            <b class="my-0.5 block font-display text-[21px] font-bold">{k.v}</b>
            <i class:list={['text-[11px] not-italic', k.alert ? 'text-coral' : 'text-champagne']}>{k.d}</i>
          </div>
        ))}
      </div>
      <div class="grid gap-2.5 sm:grid-cols-[1.4fr_1fr]">
        <div class="glass-dark rounded-2xl p-3">
          <small class="block text-[11px] text-mist">Revenue vs target</small>
          <svg viewBox="0 0 300 120" class="mt-2 block w-full">
            <defs><linearGradient id="area-fill" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#D9C48E" stop-opacity=".35" /><stop offset="1" stop-color="#D9C48E" stop-opacity="0" /></linearGradient></defs>
            <g stroke="rgb(255 255 255/.1)"><line x1="8" y1="100" x2="292" y2="100" /><line x1="8" y1="66" x2="292" y2="66" /><line x1="8" y1="32" x2="292" y2="32" /></g>
            <path d={`${line}V100H8Z`} fill="url(#area-fill)" />
            <path d={line} pathLength="1" class="draw" fill="none" stroke="#D9C48E" stroke-width="2" stroke-linejoin="round" />
            <path d="M8 80L292 40" stroke="#B5B3AD" stroke-width="1.3" stroke-dasharray="4 4" fill="none" />
            <circle cx="138" cy="70" r="4" fill="#FF5A3C" />
            <g font-size="9" fill="#B5B3AD" font-family="Space Grotesk Variable, sans-serif"><text x="8" y="114">Jan</text><text x="140" y="114">Jun</text><text x="268" y="114">Dec</text></g>
          </svg>
        </div>
        <div class="glass-dark rounded-2xl p-3">
          <small class="block text-[11px] text-mist">Margin by channel</small>
          <svg viewBox="0 0 200 120" class="mt-2 block w-full">
            {channels.map((c, i) => (
              <>
                <text x="0" y={24 + i * 28} font-size="9" fill="#B5B3AD" font-family="Space Grotesk Variable, sans-serif">{c.n}</text>
                <rect class="grow" style={`--i:${i}`} x="16" y={14 + i * 28} width={c.w} height="14" rx="5" fill={c.alert ? '#FF5A3C' : '#8E8C88'} />
              </>
            ))}
          </svg>
        </div>
      </div>
    </div>

    <div class="border-t border-white/10 bg-gradient-to-b from-champagne/[0.07] to-transparent p-[18px] lg:border-l lg:border-t-0">
      <div class="mb-3.5 flex items-center justify-between">
        <b class="flex items-center gap-2 font-label text-sm font-semibold"><i class="h-2 w-2 rounded-full bg-champagne shadow-[0_0_10px_#d9c48e]"></i>Curvaxure agent</b>
        <small class="text-mist">concept preview</small>
      </div>
      <ul class="grid gap-3 text-[13px] text-[#e3e1dc]">
        {steps.map((s, i) => (
          <li class="step flex gap-2.5 leading-snug" style={`--i:${i}`}>
            <span class:list={['grid h-[19px] w-[19px] flex-none place-items-center rounded-full text-[10px]', s.warn ? 'bg-coral/20 text-coral' : 'bg-champagne/20 text-champagne']}>{s.i}</span>{s.t}
          </li>
        ))}
      </ul>
      <div class="mt-4 flex items-center justify-between rounded-xl border border-white/20 px-3 py-2.5 text-[13px] text-mist">
        <span>Ask about channel C margin</span><i class="cursor"></i>
      </div>
    </div>
  </div>
</div>
