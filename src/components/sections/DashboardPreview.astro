---
type Kpi = {
  label: string;
  value: string;
  change: string;
  comparison: string;
  negative?: boolean;
};

const kpis: Kpi[] = [
  { label: 'Revenue', value: '$1.24M', change: '+4.2%', comparison: 'vs last year' },
  { label: 'Gross margin', value: '31.8%', change: '−1.6 pts', comparison: 'vs plan', negative: true },
  { label: 'Orders', value: '8,420', change: '+2.1%', comparison: 'vs last year' },
  { label: 'CAC', value: '$42', change: '+9%', comparison: 'vs last year', negative: true },
];

const actual = 'M8 112L32 104L56 108L80 94L104 98L128 76L152 82L176 66L200 70L224 56L248 60L272 46L296 40';
const target = 'M8 96L296 52';

const notes = [
  { text: 'Repeat orders are down 6% this quarter.', tone: 'coral' },
  { text: 'Channel C margin is below plan for three months.', tone: 'coral' },
  { text: 'Review pricing before the next campaign.', tone: 'champagne' },
];
---
<figure class="mx-auto min-w-0 w-full max-w-[680px] xl:mx-0">
  <div
    class="min-w-0 rounded-[16px] border border-line-dark bg-ink-2 p-5 text-paper md:p-6"
    aria-hidden="true"
  >
    <div class="flex items-start justify-between gap-4 border-b border-line-dark pb-4">
      <div>
        <p class="text-[11px] font-medium text-mist">Sales &amp; margin</p>
        <p class="mt-1 font-display text-[20px] font-medium leading-none">Year to date</p>
      </div>
      <p class="text-[11px] text-mist">Sample data</p>
    </div>

    <div class="mt-4 grid min-w-0 grid-cols-2 gap-px overflow-hidden rounded-[8px] border border-line-dark bg-line-dark sm:grid-cols-4">
      {kpis.map((kpi) => (
        <div class="bg-ink-2 p-3">
          <p class="text-[11px] text-mist">{kpi.label}</p>
          <p class="mt-1 text-[21px] font-medium leading-none tabular-nums">{kpi.value}</p>
          <p class="mt-2 text-[11px] text-mist">
            <span class:list={[kpi.negative ? 'text-coral' : 'text-champagne']}>{kpi.change}</span>
            {' '}{kpi.comparison}
          </p>
        </div>
      ))}
    </div>

    <div class="mt-4 grid min-w-0 gap-4 md:grid-cols-[1.45fr_1fr]">
      <div class="min-w-0 rounded-[8px] border border-line-dark p-4">
        <div class="flex flex-wrap items-center justify-between gap-2">
          <p class="text-[11px] text-mist">Revenue vs target</p>
          <div class="flex items-center gap-3 text-[11px] text-mist">
            <span class="inline-flex items-center gap-1.5">
              <i class="h-1.5 w-1.5 rounded-full bg-champagne"></i>Actual
            </span>
            <span class="inline-flex items-center gap-1.5">
              <i class="h-px w-3 border-t border-dashed border-mist"></i>Target
            </span>
          </div>
        </div>

        <svg viewBox="0 0 320 130" class="mt-3 block w-full max-w-full" role="presentation">
          <g stroke="#3A352E" stroke-width="1">
            <line x1="8" y1="116" x2="296" y2="116" />
            <line x1="8" y1="78" x2="296" y2="78" />
            <line x1="8" y1="40" x2="296" y2="40" />
          </g>
          <path d={target} fill="none" stroke="#B7AD9D" stroke-width="1.2" stroke-dasharray="4 5" />
          <path d={actual} fill="none" stroke="#D8C08A" stroke-width="1.8" stroke-linejoin="round" stroke-linecap="round" />
          <circle cx="152" cy="82" r="3" fill="#C9563B" />
        </svg>
        <div class="mt-2 flex items-center justify-between text-[11px] text-mist">
          <span>Jan</span>
          <span>Jun</span>
          <span>Dec</span>
        </div>
        <p class="mt-3 flex items-center gap-1.5 text-[11px] text-coral">
          <i class="h-1.5 w-1.5 flex-none rounded-full bg-coral"></i>
          Channel C margin below plan
        </p>
      </div>

      <div class="min-w-0 rounded-[8px] border border-line-dark p-4">
        <p class="text-[11px] text-mist">Decision notes</p>
        <ul class="mt-3 space-y-3 text-[11px] leading-[1.5] text-paper">
          {notes.map((note) => (
            <li class="flex gap-2">
              <i
                class:list={[
                  'mt-1.5 h-1.5 w-1.5 flex-none rounded-full',
                  note.tone === 'coral' ? 'bg-coral' : 'bg-champagne',
                ]}
              ></i>
              <span>{note.text}</span>
            </li>
          ))}
        </ul>
        <div class="mt-4 border-t border-line-dark pt-3">
          <p class="text-[11px] text-mist">Next decision</p>
          <p class="mt-1 text-[12px] leading-[1.5] text-paper">
            Hold channel C spend or fix the margin first?
          </p>
        </div>
      </div>
    </div>

    <div class="mt-4 flex flex-wrap items-center justify-between gap-2 border-t border-line-dark pt-3 text-[11px] text-mist">
      <p>Illustrative dashboard · dummy data</p>
      <p>Curvaxure</p>
    </div>
  </div>
  <figcaption class="sr-only">
    Sample sales and margin dashboard showing revenue, gross margin, orders and customer acquisition cost,
    with a revenue chart and decision notes.
  </figcaption>
</figure>
