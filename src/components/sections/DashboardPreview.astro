---
type Kpi = {
  label: string;
  value: string;
  change: string;
  comparison: string;
  negative?: boolean;
};

const kpis: Kpi[] = [
  { label: 'Organic reach', value: '142K', change: '+28%', comparison: 'vs last mo' },
  { label: 'Leads tracked', value: '920', change: '+34%', comparison: 'vs last mo' },
  { label: 'Conversion rate', value: '3.8%', change: '+0.8 pts', comparison: 'vs last qtr' },
  { label: 'Avg. ROAS', value: '4.4×', change: '+1.1×', comparison: 'vs target' },
];

const curvePath = 'M 10 95 C 60 70, 85 105, 120 102 C 160 98, 190 120, 230 115 C 280 110, 310 40, 380 25';
---
<figure class="mx-auto min-w-0 w-full max-w-[680px] xl:mx-0">
  <div
    class="min-w-0 rounded-[20px] p-6 shadow-2xl backdrop-blur-xl transition-colors duration-200"
    style="border: 1px solid var(--color-line-mid); background: var(--console-bg); color: var(--color-primary)"
    aria-hidden="true"
  >
    <!-- Card Header -->
    <div class="flex items-center justify-between gap-4 pb-4" style="border-bottom: 1px solid var(--color-line)">
      <div class="flex items-center gap-3">
        <div class="h-2.5 w-2.5 rounded-full" style="background: var(--color-lime)"></div>
        <div>
          <p class="font-mono text-[11px] uppercase tracking-wider" style="color: var(--color-muted)">GROWTH CURVE CONSOLE</p>
          <p class="font-display text-[19px] font-medium leading-none mt-0.5" style="color: var(--color-primary)">What shapes the curve</p>
        </div>
      </div>
      <span class="rounded-full px-2.5 py-1 text-[11px] font-mono" style="border: 1px solid var(--color-line-mid); background: var(--color-surface-3); color: var(--color-secondary)">
        Real-time telemetry
      </span>
    </div>

    <!-- 4 KPI counters in a row -->
    <div class="mt-4 grid min-w-0 grid-cols-2 gap-px overflow-hidden rounded-[12px] sm:grid-cols-4" style="background: var(--color-line); border: 1px solid var(--color-line)">
      {kpis.map((kpi) => (
        <div class="p-3.5" style="background: var(--color-surface-2)">
          <p class="text-[11px] font-mono uppercase tracking-wide" style="color: var(--color-muted)">{kpi.label}</p>
          <p class="mt-1 text-[22px] font-medium leading-none tabular-nums" style="color: var(--color-primary)">{kpi.value}</p>
          <p class="mt-2 text-[11px]" style="color: var(--color-muted)">
            <span style={kpi.negative ? 'color: var(--color-negative)' : 'color: var(--color-positive)'}>{kpi.change}</span>
            {' '}{kpi.comparison}
          </p>
        </div>
      ))}
    </div>

    <!-- The Interactive Curve Visual -->
    <div class="mt-4 rounded-[12px] p-4 relative overflow-hidden" style="border: 1px solid var(--color-line); background: var(--chart-bg)">
      <div class="flex items-center justify-between mb-2">
        <span class="text-[11px] font-mono uppercase tracking-wider" style="color: var(--color-muted)">Curve dynamics: friction vs acceleration</span>
        <span class="text-[11px] font-mono font-medium" style="color: var(--color-lime-text)">● Rising trajectory</span>
      </div>

      <div class="relative w-full h-[140px]">
        <!-- Technical grid lines -->
        <svg viewBox="0 0 400 140" class="w-full h-full block" preserveAspectRatio="none">
          <defs>
            <linearGradient id="curveGradient" x1="0" y1="0" x2="1" y2="0">
              <stop offset="0%" stop-color="#7D39EB" />
              <stop offset="60%" stop-color="#7D39EB" />
              <stop offset="100%" stop-color="#C6FF33" />
            </linearGradient>
          </defs>

          <!-- Horizontal guide lines -->
          <line x1="0" y1="30" x2="400" y2="30" stroke="var(--color-line)" stroke-dasharray="3 3" />
          <line x1="0" y1="70" x2="400" y2="70" stroke="var(--color-line)" stroke-dasharray="3 3" />
          <line x1="0" y1="110" x2="400" y2="110" stroke="var(--color-line)" stroke-dasharray="3 3" />

          <!-- Target benchmark line -->
          <line x1="10" y1="85" x2="390" y2="45" stroke="var(--color-line-mid)" stroke-width="1.2" stroke-dasharray="4 4" />

          <!-- The Growth Curve Line -->
          <path
            d={curvePath}
            fill="none"
            stroke="url(#curveGradient)"
            stroke-width="3"
            stroke-linecap="round"
          />

          <!-- Inflection Dots -->
          <circle cx="100" cy="103" r="4.5" fill="#7D39EB" stroke="#fff" stroke-width="1.5" />
          <circle cx="210" cy="118" r="4.5" fill="#7D39EB" stroke="#fff" stroke-width="1.5" />
          <circle cx="360" cy="28" r="5" fill="#C6FF33" stroke="#000" stroke-width="1.5" />
        </svg>

        <!-- Annotations floating over the SVG -->
        <div class="absolute left-[20%] top-[70%] -translate-x-1/2">
          <span class="inline-flex items-center rounded-full px-2.5 py-0.5 text-[10px] font-mono font-medium text-white shadow-md backdrop-blur-sm" style="background: rgba(125, 57, 235, 0.9); border: 1px solid rgba(255,255,255,0.2)">
            Hidden costs
          </span>
        </div>

        <div class="absolute left-[50%] top-[82%] -translate-x-1/2">
          <span class="inline-flex items-center rounded-full px-2.5 py-0.5 text-[10px] font-mono font-medium text-white shadow-md backdrop-blur-sm" style="background: rgba(125, 57, 235, 0.9); border: 1px solid rgba(255,255,255,0.2)">
            Slow processes
          </span>
        </div>

        <div class="absolute right-[5%] top-[8%]">
          <span class="inline-flex items-center rounded-full px-2.5 py-0.5 text-[10px] font-mono font-semibold text-black shadow-lg" style="background: var(--color-lime)">
            Better decisions ↑
          </span>
        </div>
      </div>
    </div>

    <!-- Bottom summary pills (Search / Automation / CRM) -->
    <div class="mt-4 grid grid-cols-3 gap-2.5 text-center">
      <div class="rounded-[8px] p-2.5" style="border: 1px solid var(--color-line); background: var(--color-surface-2)">
        <p class="font-mono text-[10px] uppercase" style="color: var(--color-muted)">Acquisition</p>
        <p class="text-[13px] font-medium mt-0.5" style="color: var(--color-primary)">SEO · GEO · Ads</p>
      </div>
      <div class="rounded-[8px] p-2.5" style="border: 1px solid var(--color-line); background: var(--color-surface-2)">
        <p class="font-mono text-[10px] uppercase" style="color: var(--color-muted)">Operations</p>
        <p class="text-[13px] font-medium mt-0.5" style="color: var(--color-primary)">n8n · Zapier</p>
      </div>
      <div class="rounded-[8px] p-2.5" style="border: 1px solid var(--color-line); background: var(--color-surface-2)">
        <p class="font-mono text-[10px] uppercase" style="color: var(--color-muted)">Intelligence</p>
        <p class="text-[13px] font-medium mt-0.5" style="color: var(--color-primary)">Custom CRM · BI</p>
      </div>
    </div>
  </div>
  <figcaption class="sr-only">
    Interactive growth curve console demonstrating points of friction like hidden costs and slow processes shifting upward to better decisions.
  </figcaption>
</figure>
