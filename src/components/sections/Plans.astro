---
import Button from '@/components/ui/Button.astro';
import { site } from '@/config/site';
// Plan limits are examples until packages and pricing are decided. No prices shown.
const plans = [
  { name: 'Starter', sub: 'Get clarity fast', price: 'Setup + retainer', cta: 'Start here', featured: false,
    features: ['Up to 3 data sources', '2 dashboards', 'Cleaning and modeling', 'Scheduled refresh', 'Monthly insight review'] },
  { name: 'Growth', sub: 'Decide with confidence', price: 'Setup + retainer', cta: 'Choose Growth →', featured: true,
    features: ['Up to 8 data sources', '6 dashboards', 'Custom KPI development', 'Weekly insight meetings', 'Forecasting add-on'] },
  { name: 'Enterprise', sub: 'Scale the whole curve', price: 'Custom', cta: 'Talk to us', featured: false,
    features: ['Custom data source scope', 'Tailored dashboards', 'Advanced analytics and automation', 'Weekly meetings, priority support', 'User access and security'] },
];
---
<section id="plans" class="relative -mt-10 rounded-t-[40px] bg-paper pb-24 pt-24">
  <div class="mx-auto max-w-6xl px-5">
    <div class="mx-auto mb-12 max-w-[34em] text-center">
      <h2 class="text-[clamp(34px,5.4vw,58px)]">Flexible plans, real impact</h2>
      <p class="mt-4 text-[19px] text-slate">One-time discovery and setup, then an optional monthly partnership. Weekly insight meetings come with Growth and Enterprise.</p>
    </div>

    <div class="plans-grid grid items-end gap-5 md:grid-cols-[1fr_1.1fr_1fr]">
      {plans.map((p, k) => (
        <article class:list={['plan reveal rounded-[28px]', p.featured ? 'plan-dark bg-ink p-10 text-white' : 'border-[1.5px] border-line bg-white p-8']} style={`--d:${k}`}>
          {p.featured && <span class="label absolute -top-3 right-6 rounded-full bg-champagne px-3 py-1.5 text-ink">Most requested</span>}
          <h3 class="text-[30px]">{p.name}</h3>
          <p class:list={['mb-4 mt-1.5 text-sm', p.featured ? 'text-mist' : 'text-slate']}>{p.sub}</p>
          <p class="mb-4 font-display text-[26px] font-extrabold tracking-[-0.03em]">{p.price}</p>
          <ul class="mb-6 text-[15px]">
            {p.features.map((f, i) => (
              <li class="relative py-1.5 pl-6" style={`--i:${i}`}><i class="absolute left-0 top-[13px] h-[11px] w-[11px] rounded-full bg-champagne"></i>{f}</li>
            ))}
          </ul>
          <Button href={`/book-consultation?plan=${p.name.toLowerCase()}&source=plans`} variant={p.featured ? 'accent' : 'secondary'} class="w-full">{p.cta}</Button>
        </article>
      ))}
    </div>

    <div class="relative mt-14 grid items-center gap-6 overflow-hidden rounded-[36px] bg-gradient-to-br from-pan to-[#3e3d45] p-9 text-white md:grid-cols-[1.3fr_1fr] md:p-12">
      <i class="pointer-events-none absolute -right-14 -top-16 h-64 w-64 rounded-full bg-champagne/20" aria-hidden="true"></i>
      <div class="relative">
        <h2 class="text-[clamp(32px,4.6vw,52px)]">Not sure where your curve is heading?</h2>
        <p class="mt-3.5 text-mist">Book a free consultation or request a data assessment. We'll map your sources and show you what's possible.</p>
      </div>
      <div class="relative flex flex-wrap gap-3">
        <Button href="/book-consultation?source=final-cta" variant="accent">Book a consultation →</Button>
        <Button href={`mailto:${site.contactEmail}`} variant="secondary">Email us</Button>
      </div>
    </div>
  </div>
</section>
