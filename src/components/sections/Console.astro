---
import Button from '@/components/ui/Button.astro';

const scenarios = [
  {
    slug: 'increase-sales',
    label: 'Increase sales',
    insight: 'Repeat customers order less this quarter, while new-customer orders hold steady.',
    decision: 'Focus on keeping customers or winning new ones?',
    direction: 'Compare sales by customer segment and product before the next campaign plan.',
  },
  {
    slug: 'improve-profitability',
    label: 'Improve profitability',
    insight: 'Revenue is growing, but rising labor and supplier costs are reducing project margins.',
    decision: 'Which projects and cost categories deserve action first?',
    direction: 'Review cost categories, project performance and margin changes before the next planning cycle.',
  },
  {
    slug: 'control-project-costs',
    label: 'Control project costs',
    insight: 'Labor costs are rising faster than project progress on two active projects.',
    decision: 'Adjust resources now or wait for the next milestone?',
    direction: 'Review crew allocation, overtime and subcontractor performance before the next milestone.',
  },
  {
    slug: 'improve-marketing',
    label: 'Improve marketing',
    insight: 'One channel brings high traffic but low contribution margin.',
    decision: 'Where should the next marketing budget go?',
    direction: 'Shift budget by profitable customer acquisition, not traffic volume alone.',
  },
  {
    slug: 'understand-customers',
    label: 'Understand customers',
    insight: 'A small group of customers accounts for most repeat purchases.',
    decision: 'Which customer groups are worth investing in?',
    direction: 'Compare segments by lifetime value and repeat behavior.',
  },
  {
    slug: 'improve-operations',
    label: 'Improve operations',
    insight: 'Delays cluster around a few recurring steps in the process.',
    decision: 'Which step is worth fixing first?',
    direction: 'Review timing step by step and compare against the plan.',
  },
  {
    slug: 'plan-future-growth',
    label: 'Plan future growth',
    insight: 'Capacity looks fully booked early in the year and open later.',
    decision: 'Hire, pause, or push sales now?',
    direction: 'Compare the pipeline with planned capacity before making commitments.',
  },
];

const start = 0;
---
<section id="console" class="border-t border-line-dark bg-ink pb-24 pt-20 text-paper md:pb-32 md:pt-24" data-console>
  <div class="container-page">
    <div class="grid gap-6 md:grid-cols-[minmax(0,7fr)_minmax(0,5fr)] md:items-end">
      <div>
        <p class="eyebrow text-mist">Sample decision</p>
        <h2 class="mt-4 max-w-[15em] text-[clamp(32px,4.4vw,56px)]">
          Pick a question. See how the numbers become a decision
        </h2>
      </div>
      <p class="max-w-[30em] text-[15px] leading-[1.7] text-mist md:justify-self-end">
        Seven illustrative examples using dummy data. Each one follows the same three
        steps: what the data shows, the decision, and a next move.
      </p>
    </div>

    <div class="mt-12 overflow-hidden rounded-[16px] border border-line-dark bg-paper text-ink">
      <div class="border-b border-line px-6 py-4 md:px-8">
        <div class="flex flex-wrap items-center justify-between gap-2">
          <p class="text-[12px] font-medium text-slate">Decision brief</p>
          <p class="text-[12px] text-slate">Illustrative · dummy data</p>
        </div>
      </div>

      <div class="grid min-w-0 md:grid-cols-[minmax(0,4fr)_minmax(0,8fr)]">
        <div class="min-w-0 border-b border-line p-6 md:border-b-0 md:border-r md:p-8">
          <p class="text-[12px] font-medium text-slate">Questions</p>
          <div
            class="mt-4 grid min-w-0 grid-cols-2 gap-2 md:block md:space-y-1"
            role="group"
            aria-label="Choose a question"
          >
            {scenarios.map((scenario, index) => (
              <button
                type="button"
                data-chip
                aria-pressed={index === start}
                class="flex w-full items-center gap-3 rounded-[6px] px-3 py-2.5 text-left text-[14px] text-slate transition-colors duration-150 hover:bg-paper-2 hover:text-ink aria-pressed:bg-ink aria-pressed:text-paper"
              >
                <span class="text-[11px] tabular-nums opacity-70">
                  {String(index + 1).padStart(2, '0')}
                </span>
                <span>{scenario.label}</span>
              </button>
            ))}
          </div>
        </div>

        <div class="min-w-0 p-6 md:p-8">
          <div class="min-w-0" aria-live="polite">
            {scenarios.map((scenario, index) => (
              <div data-panel data-slug={scenario.slug} hidden={index !== start}>
                <div class="flex items-baseline justify-between gap-4 border-b border-line pb-4">
                  <h3 class="text-[24px]">{scenario.label}</h3>
                  <p class="text-[12px] tabular-nums text-slate">
                    {String(index + 1).padStart(2, '0')} / {String(scenarios.length).padStart(2, '0')}
                  </p>
                </div>

                <div class="divide-y divide-line">
                  <div class="grid gap-2 py-5 sm:grid-cols-[140px_1fr] sm:gap-6">
                    <p class="text-[12px] font-medium text-slate">What the data shows</p>
                    <p class="text-[15px] leading-[1.65] text-ink">{scenario.insight}</p>
                  </div>
                  <div class="grid gap-2 py-5 sm:grid-cols-[140px_1fr] sm:gap-6">
                    <p class="text-[12px] font-medium text-slate">The decision</p>
                    <p class="text-[15px] leading-[1.65] text-ink">{scenario.decision}</p>
                  </div>
                  <div class="grid gap-2 py-5 sm:grid-cols-[140px_1fr] sm:gap-6">
                    <p class="text-[12px] font-medium text-slate">A next move</p>
                    <p class="text-[15px] leading-[1.65] text-ink">{scenario.direction}</p>
                  </div>
                </div>

                <div class="mt-6 flex flex-wrap items-center justify-between gap-4">
                  <p class="text-[12px] text-slate">Illustrative example. Not a client result.</p>
                  <Button
                    data-cta
                    href={`/book-consultation?focus=${scenarios[start].slug}&source=console`}
                    class="h-10 w-full px-4 text-[13px] sm:w-auto"
                  >
                    Talk through your own numbers
                  </Button>
                </div>
              </div>
            ))}
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  const root = document.querySelector<HTMLElement>('[data-console]');
  if (root) {
    const chips = [...root.querySelectorAll<HTMLButtonElement>('[data-chip]')];
    const panels = [...root.querySelectorAll<HTMLElement>('[data-panel]')];
    const cta = root.querySelector<HTMLAnchorElement>('[data-cta]');

    chips.forEach((chip, index) =>
      chip.addEventListener('click', () => {
        chips.forEach((item, itemIndex) =>
          item.setAttribute('aria-pressed', String(itemIndex === index)),
        );
        panels.forEach((panel, panelIndex) => (panel.hidden = panelIndex !== index));
        if (cta) {
          cta.href = `/book-consultation?focus=${panels[index].dataset.slug}&source=console`;
        }
      }),
    );
  }
</script>
