---
import Button from '@/components/ui/Button.astro';
// Illustrative scenarios. Dummy data, not client results.
const scenarios = [
  { slug: 'increase-sales', label: 'Increase sales', insight: 'Repeat customers order less this quarter, while new-customer orders hold steady.', decision: 'Focus on keeping customers or winning new ones?', direction: 'Compare sales by customer segment and product before the next campaign plan.' },
  { slug: 'improve-profitability', label: 'Improve profitability', insight: 'Revenue is growing, but rising labor and supplier costs are reducing project margins.', decision: 'Which projects and cost categories deserve action first?', direction: 'Review cost categories, project performance and margin changes before the next planning cycle.' },
  { slug: 'control-project-costs', label: 'Control project costs', insight: 'Labor costs are rising faster than project progress on two active projects.', decision: 'Adjust resources now or wait for the next milestone?', direction: 'Review crew allocation, overtime and subcontractor performance before the next milestone.' },
  { slug: 'improve-marketing', label: 'Improve marketing', insight: 'One channel brings high traffic but low contribution margin.', decision: 'Where should the next marketing budget go?', direction: 'Shift budget by profitable customer acquisition, not traffic volume alone.' },
  { slug: 'understand-customers', label: 'Understand customers', insight: 'A small group of customers accounts for most repeat purchases.', decision: 'Which customer groups are worth investing in?', direction: 'Compare segments by lifetime value and repeat behavior.' },
  { slug: 'improve-operations', label: 'Improve operations', insight: 'Delays cluster around a few recurring steps in the process.', decision: 'Which step is worth fixing first?', direction: 'Review timing step by step and compare against the plan.' },
  { slug: 'plan-future-growth', label: 'Plan future growth', insight: 'Capacity looks fully booked early in the year and open later.', decision: 'Hire, pause, or push sales now?', direction: 'Compare the pipeline with planned capacity before making commitments.' },
];
const start = 1;
const blocks = [
  { key: 'insight', title: 'What the data might show', tone: 'border-champagne' },
  { key: 'decision', title: 'Decision point', tone: 'border-coral' },
  { key: 'direction', title: 'Possible direction', tone: 'border-steel' },
] as const;
---
<section id="console" class="relative bg-ink pb-24 text-white" data-console>
  <div class="mx-auto max-w-6xl px-5">
    <div class="glass-dark rounded-[32px] p-6 md:p-9">
      <h2 class="mb-6 max-w-[16em] text-[clamp(30px,4.6vw,46px)]">Which part of your growth curve needs attention?</h2>
      <div class="mb-6 flex flex-wrap gap-2.5" role="group" aria-label="Choose a focus area">
        {scenarios.map((s, i) => (
          <button type="button" data-chip aria-pressed={i === start}
            class="rounded-full border-[1.5px] border-white/20 px-[18px] py-2.5 text-[15px] font-medium transition hover:border-champagne/60 aria-pressed:border-champagne aria-pressed:bg-champagne aria-pressed:font-semibold aria-pressed:text-ink">{s.label}</button>
        ))}
      </div>
      <div aria-live="polite">
        {scenarios.map((s, i) => (
          <div data-panel data-slug={s.slug} hidden={i !== start} class="grid gap-3 md:grid-cols-3">
            {blocks.map((b) => (
              <div class:list={['glass-dark rounded-2xl border-t-[3px] p-5', b.tone]}>
                <h3 class="label mb-2.5 text-mist">{b.title}</h3>
                <p class="text-[#e9e2fa]">{s[b.key]}</p>
              </div>
            ))}
          </div>
        ))}
      </div>
      <p class="mt-4 text-[13px] text-mist">Illustrative example using dummy data. Not a client result.</p>
      <div class="mt-6">
        <Button data-cta href={`/book-consultation?focus=${scenarios[start].slug}&source=console`} variant="accent">Explore this with a free Data Assessment</Button>
      </div>
    </div>
  </div>
</section>

<script>
  const root = document.querySelector<HTMLElement>('[data-console]');
  if (root) {
    const chips = [...root.querySelectorAll<HTMLButtonElement>('[data-chip]')];
    const panels = [...root.querySelectorAll<HTMLElement>('[data-panel]')];
    const cta = root.querySelector<HTMLAnchorElement>('[data-cta]');
    chips.forEach((chip, i) =>
      chip.addEventListener('click', () => {
        chips.forEach((c, j) => c.setAttribute('aria-pressed', String(j === i)));
        panels.forEach((p, j) => (p.hidden = j !== i));
        if (cta) cta.href = `/book-consultation?focus=${panels[i].dataset.slug}&source=console`;
      }),
    );
  }
</script>
