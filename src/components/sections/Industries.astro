---
// Illustrative mini-widgets only. No client data.
const industries = [
  { name: 'Construction', outcome: 'See where the project curve is moving before margin disappears.', href: '/industries/construction-analytics', kind: 'bars', bars: [40, 60, 80, 55, 70], alert: 2 },
  { name: 'E-commerce', outcome: 'Grow the channels that create profit, not just traffic.', href: '/industries/ecommerce-analytics', kind: 'bars', bars: [30, 75, 50, 90, 45], alert: 2 },
  { name: 'Professional services', outcome: 'Turn team capacity into more profitable work.', href: '/industries/professional-services-analytics', kind: 'ring', bars: [], alert: -1 },
];
---
<section id="industries" class="relative overflow-hidden rounded-t-[40px] bg-ink pb-24 pt-16 text-white">
  <div class="pointer-events-none absolute inset-0" aria-hidden="true"></div>
  <div class="relative mx-auto max-w-6xl px-5">
    <div class="mb-10 flex flex-wrap items-end justify-between gap-4">
      <h2 class="text-[clamp(34px,5.4vw,58px)]">Built for your industry</h2>
      <span class="label text-mist">3 focus industries · more coming</span>
    </div>
    <div class="grid gap-5 md:grid-cols-3">
      {industries.map((it, i) => (
        <a href={it.href} class="glass-dark reveal group block rounded-[28px] p-6 hover:-translate-y-1.5" style={`--d:${i}`}>
          <div class="mb-5 flex h-[120px] items-end justify-center gap-2 rounded-2xl bg-white/5 p-4" aria-hidden="true">
            {it.kind === 'bars'
              ? it.bars.map((h, j) => (
                  <span class:list={['block w-[22px] rounded-t-lg', j === it.alert ? 'bg-coral' : 'bg-steel/70']} style={`height:${h}%`}></span>
                ))
              : <span class="grid h-[84px] w-[84px] place-items-center self-center rounded-full" style="background:conic-gradient(#d9c48e 0 68%,rgb(255 255 255/.15) 0)"><span class="h-[52px] w-[52px] rounded-full bg-pan"></span></span>}
          </div>
          <h3 class="mb-2 text-[28px]">{it.name}</h3>
          <p class="mb-4 text-[15px] text-mist">{it.outcome}</p>
          <span class="text-sm font-semibold text-champagne">Explore analytics <span class="inline-block transition-transform group-hover:translate-x-1">→</span></span>
        </a>
      ))}
    </div>
  </div>
</section>
