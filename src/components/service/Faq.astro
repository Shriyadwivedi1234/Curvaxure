---
import SectionHead from './SectionHead.astro';
interface Props { items: { q: string; a: string }[]; }
const { items } = Astro.props;
const schema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: items.map((i) => ({ '@type': 'Question', name: i.q, acceptedAnswer: { '@type': 'Answer', text: i.a } })),
};
---
<section class="py-20 md:py-28" style="border-top: 1px solid var(--color-line); background: var(--color-surface)">
  <div class="container-page">
    <SectionHead eyebrow="FAQ" title="Questions we usually get." />
    <div class="mt-10 divide-y" style="border-top: 1px solid var(--color-line); border-bottom: 1px solid var(--color-line); --tw-divide-color: var(--color-line)">
      {items.map((item) => (
        <details class="faq group py-5">
          <summary class="flex cursor-pointer list-none items-center justify-between gap-6 text-[17px] font-medium [&::-webkit-details-marker]:hidden" style="color: var(--color-primary)">
            <span>{item.q}</span>
            <span class="faq-icon flex h-7 w-7 flex-none items-center justify-center rounded-full text-[16px]" style="border: 1px solid var(--color-line-mid); color: var(--color-lime-text)">+</span>
          </summary>
          <p class="mt-3 max-w-[48em] text-[15px] leading-[1.7]" style="color: var(--color-secondary)">{item.a}</p>
        </details>
      ))}
    </div>
  </div>
  <script type="application/ld+json" set:html={JSON.stringify(schema)} />
</section>

<style>
  .faq[open] .faq-icon { transform: rotate(45deg); }
  .faq-icon { transition: transform 200ms ease; }
</style>
