---
// Shared animation styles + scroll reveal. Import once per page.
---
<script is:inline>document.documentElement.classList.add('js');</script>

<style is:global>
  /* Scroll reveal (only hides content when JS is running) */
  .js [data-reveal] {
    opacity: 0;
    transform: translateY(18px);
    transition: opacity 700ms cubic-bezier(0.22, 1, 0.36, 1), transform 700ms cubic-bezier(0.22, 1, 0.36, 1);
    transition-delay: var(--d, 0ms);
  }
  .js [data-reveal].in { opacity: 1; transform: none; }

  /* SVG / illustration animations */
  .cvx-float { animation: cvx-float 4s ease-in-out infinite; }
  .cvx-pulse { transform-box: fill-box; transform-origin: center; animation: cvx-pulse 2s ease-in-out infinite; }
  .cvx-dash { stroke-dasharray: 6 8; animation: cvx-dash 1s linear infinite; }
  .cvx-draw { stroke-dasharray: 200; stroke-dashoffset: 200; animation: cvx-draw 3s ease-out infinite; }
  .cvx-bar { transform-box: fill-box; transform-origin: bottom; animation: cvx-bar 2.8s ease-in-out infinite; }
  .cvx-blink { animation: cvx-blink 1.2s ease-in-out infinite; }
  .cvx-swing { animation: cvx-swing 3.4s ease-in-out infinite; }
  .cvx-flicker { transform-box: fill-box; transform-origin: top; animation: cvx-flicker 0.35s ease-in-out infinite alternate; }
  .cvx-pop { transform-box: fill-box; transform-origin: center; animation: cvx-pop 2.6s ease-in-out infinite; }
  .cvx-spin { animation: cvx-spin 42s linear infinite; }
  .cvx-spin-rev { animation: cvx-spin 42s linear infinite reverse; }
  .cvx-orbit:hover .cvx-spin, .cvx-orbit:hover .cvx-spin-rev { animation-play-state: paused; }
  .cvx-drip { animation: cvx-drip 1.7s ease-in infinite; }
  .cvx-fall { animation: cvx-fall 2.2s linear infinite; }
  .cvx-marquee { animation: cvx-marquee 40s linear infinite; }
  .cvx-marquee:hover { animation-play-state: paused; }
  .cvx-ping { animation: cvx-ping 2s cubic-bezier(0, 0, 0.2, 1) infinite; }

  /* Animated connector lines for HTML flowcharts */
  .cvx-line-x {
    height: 2px;
    background: repeating-linear-gradient(90deg, var(--color-violet) 0 6px, transparent 6px 12px);
    background-size: 12px 2px;
    animation: cvx-flow-x 0.9s linear infinite;
  }
  .cvx-line-y {
    width: 2px;
    background: repeating-linear-gradient(180deg, var(--color-violet) 0 6px, transparent 6px 12px);
    background-size: 2px 12px;
    animation: cvx-flow-y 0.9s linear infinite;
  }

  .cvx-orbit { --r: 150px; }
  @media (max-width: 480px) { .cvx-orbit { --r: 112px; } }

  @keyframes cvx-float { 0%, 100% { transform: translateY(0); } 50% { transform: translateY(-6px); } }
  @keyframes cvx-pulse { 0%, 100% { transform: scale(1); opacity: 1; } 50% { transform: scale(1.08); opacity: 0.85; } }
  @keyframes cvx-dash { to { stroke-dashoffset: -14; } }
  @keyframes cvx-draw { 0% { stroke-dashoffset: 200; } 55%, 100% { stroke-dashoffset: 0; } }
  @keyframes cvx-bar { 0%, 100% { transform: scaleY(0.55); } 50% { transform: scaleY(1); } }
  @keyframes cvx-blink { 0%, 100% { opacity: 0.25; } 50% { opacity: 1; } }
  @keyframes cvx-swing { 0%, 100% { transform: rotate(-7deg); } 50% { transform: rotate(7deg); } }
  @keyframes cvx-flicker { from { transform: scaleY(0.8); } to { transform: scaleY(1.25); } }
  @keyframes cvx-pop { 0%, 100% { transform: scale(0.9); } 50% { transform: scale(1.12); } }
  @keyframes cvx-spin { to { transform: rotate(360deg); } }
  @keyframes cvx-drip { 0% { transform: translateY(0); opacity: 0; } 15% { opacity: 1; } 100% { transform: translateY(46px); opacity: 0; } }
  @keyframes cvx-fall { 0% { transform: translateY(0); opacity: 0; } 15% { opacity: 1; } 100% { transform: translateY(80px); opacity: 0; } }
  @keyframes cvx-marquee { to { transform: translateX(-50%); } }
  @keyframes cvx-ping { 75%, 100% { transform: scale(2.2); opacity: 0; } }
  @keyframes cvx-flow-x { to { background-position-x: 12px; } }
  @keyframes cvx-flow-y { to { background-position-y: 12px; } }
</style>

<script>
  const els = document.querySelectorAll<HTMLElement>('[data-reveal]');
  if ('IntersectionObserver' in window) {
    const io = new IntersectionObserver(
      (entries) => {
        entries.forEach((e) => {
          if (e.isIntersecting) {
            e.target.classList.add('in');
            io.unobserve(e.target);
          }
        });
      },
      { threshold: 0.12, rootMargin: '0px 0px -40px 0px' }
    );
    els.forEach((el) => io.observe(el));
  } else {
    els.forEach((el) => el.classList.add('in'));
  }
</script>
