---
interface Props { name: string; class?: string; }
const { name, class: cls = 'h-6 w-6' } = Astro.props;
---
<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" class={cls} aria-hidden="true">
  {name === 'search' && (<><circle cx="11" cy="11" r="6" /><path d="M20 20l-4.5-4.5" /></>)}
  {name === 'browser' && (<><rect x="3" y="5" width="18" height="14" rx="3" /><path d="M3 9h18" /></>)}
  {name === 'inbox' && (<><path d="M4 13l2-7h12l2 7v5H4z" /><path d="M4 13h5l1 2h4l1-2h5" /></>)}
  {name === 'database' && (<><ellipse cx="12" cy="6" rx="7" ry="3" /><path d="M5 6v6c0 1.7 3.1 3 7 3s7-1.3 7-3V6" /><path d="M5 12v6c0 1.7 3.1 3 7 3s7-1.3 7-3v-6" /></>)}
  {name === 'chart' && (<><path d="M4 20V11M10 20V4M16 20v-6M2 20h20" /></>)}
  {name === 'bolt' && (<path d="M13 2L4 14h7l-1 8 9-12h-7z" />)}
  {name === 'check' && (<path d="M5 12l5 5 9-10" />)}
  {name === 'arrow' && (<path d="M5 12h14M13 6l6 6-6 6" />)}
  {name === 'target' && (<><circle cx="12" cy="12" r="8" /><circle cx="12" cy="12" r="3" /></>)}
  {name === 'blueprint' && (<><rect x="4" y="4" width="16" height="16" rx="2" /><path d="M4 10h16M10 4v16" /></>)}
  {name === 'build' && (<path d="M14 6l4 4-9 9H5v-4z" />)}
  {name === 'loop' && (<><path d="M4 12a8 8 0 0114-5l2 2M20 12a8 8 0 01-14 5l-2-2" /><path d="M20 4v5h-5M4 20v-5h5" /></>)}
</svg>
