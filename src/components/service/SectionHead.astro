---
interface Props { eyebrow: string; title: string; intro?: string; }
const { eyebrow, title, intro } = Astro.props;
---
<div class="grid gap-6 md:grid-cols-[minmax(0,7fr)_minmax(0,5fr)] md:items-end">
  <div>
    <div class="mb-4 inline-flex items-center gap-2 rounded-full px-3 py-1 text-[11px] font-mono uppercase tracking-wider" style="border: 1px solid var(--color-line-mid); background: var(--color-surface-2); color: var(--color-lime-text)">
      <span>{eyebrow}</span>
    </div>
    <h2 class="max-w-[16em] text-[clamp(30px,4vw,48px)] font-medium tracking-[-0.03em]" style="color: var(--color-primary)">{title}</h2>
  </div>
  {intro && <p class="max-w-[32em] text-[16px] leading-[1.7] md:justify-self-end" style="color: var(--color-secondary)">{intro}</p>}
</div>
