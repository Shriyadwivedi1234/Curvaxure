---
import Logo from '@/components/ui/Logo.astro';
import { nav } from '@/config/site';
---
<header class="sticky top-0 z-50 border-b border-line bg-paper">
  <div class="container-page flex h-[72px] items-center justify-between gap-6">
    <Logo />

    <nav aria-label="Main" class="hidden items-center gap-8 md:flex">
      {nav.map((item) => (
        <a
          href={item.href}
          class="whitespace-nowrap text-[14px] font-medium text-slate transition-colors duration-150 hover:text-ink"
        >
          {item.label}
        </a>
      ))}
    </nav>

    <div class="flex items-center gap-2.5">
      <a
        href="/book-consultation"
        class="inline-flex h-9 items-center justify-center rounded-[8px] bg-ink px-4 text-[13px] font-medium text-paper transition-colors duration-150 hover:bg-ink-3"
      >
        Book a call
      </a>

      <details class="relative md:hidden">
        <summary
          class="flex h-9 cursor-pointer list-none items-center rounded-[8px] border border-line px-3 text-[13px] font-medium text-ink [&::-webkit-details-marker]:hidden"
        >
          Menu
        </summary>
        <nav
          aria-label="Mobile"
          class="absolute right-0 mt-2 w-60 rounded-[12px] border border-line bg-paper p-2"
        >
          <ul>
            {nav.map((item) => (
              <li>
                <a
                  href={item.href}
                  class="block rounded-[6px] px-3 py-2.5 text-[14px] font-medium text-slate transition-colors hover:bg-paper-2 hover:text-ink"
                >
                  {item.label}
                </a>
              </li>
            ))}
          </ul>
        </nav>
      </details>
    </div>
  </div>
</header>
