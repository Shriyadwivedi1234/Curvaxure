---
import Logo from '@/components/ui/Logo.astro';
import { nav, serviceMenu, industryMenu } from '@/config/site';
---
<header class="sticky top-0 z-50 w-full px-4 pt-3 pb-2 transition-all">
  <div
    class="container-page relative flex h-14 items-center justify-between gap-4 rounded-full px-3 md:px-6 shadow-xl backdrop-blur-md transition-colors duration-200"
    style="background: var(--header-bg); border: 1px solid var(--color-line-mid)"
  >
    <Logo />

    <nav aria-label="Main" class="hidden items-center gap-10 md:flex">
      {nav.map((item) => (
        <div class="nav-item group/nav flex h-14 items-center">
          <a
            href={item.href}
            class="group flex items-center gap-1 whitespace-nowrap text-[14px] font-medium transition-colors duration-150"
            style="color: var(--color-secondary)"
            onmouseover="this.style.color='var(--color-primary)'"
            onmouseout="this.style.color='var(--color-secondary)'"
            aria-haspopup={'menu' in item ? 'true' : undefined}
          >
            <span>{item.label}</span>
            <svg class="h-3 w-3 opacity-60 transition-transform group-hover:translate-y-0.5 group-hover:opacity-100" viewBox="0 0 16 16" fill="none">
              <path d="M4 6L8 10L12 6" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </a>

          {'menu' in item && item.menu === 'services' && (
            <div class="mega-panel" role="menu" aria-label="Services">
              <div class="mega-card">
                <div class="grid grid-cols-2 gap-2">
                  {serviceMenu.map((cat, i) => (
                    <a href={cat.href} role="menuitem" class="mega-link flex flex-col rounded-[14px] p-4">
                      <span class="flex items-center gap-2">
                        <span class="font-mono text-[11px] tabular-nums" style="color: var(--color-lime-text)">{String(i + 1).padStart(2, '0')}</span>
                        <span class="text-[15px] font-medium" style="color: var(--color-primary)">{cat.label}</span>
                      </span>
                      <span class="mt-1 text-[12.5px] leading-[1.5]" style="color: var(--color-secondary)">{cat.blurb}</span>
                      <span class="mt-3 flex flex-wrap gap-1.5">
                        {cat.items.map((t) => (
                          <span class="rounded-full px-2 py-0.5 text-[11px]" style="border: 1px solid var(--color-line); color: var(--color-muted)">{t}</span>
                        ))}
                      </span>
                    </a>
                  ))}
                </div>
                <div class="mt-2 flex items-center justify-between rounded-[14px] px-4 py-3" style="background: var(--color-surface-3)">
                  <span class="text-[12.5px]" style="color: var(--color-secondary)">Four disciplines, one growth engine.</span>
                  <a href="/services" role="menuitem" class="text-[13px] font-medium" style="color: var(--color-lime-text)">View all services →</a>
                </div>
              </div>
            </div>
          )}

          {'menu' in item && item.menu === 'industries' && (
            <div class="mega-panel" role="menu" aria-label="Industries">
              <div class="mega-card mega-card-narrow">
                <div class="grid grid-cols-1 gap-1">
                  {industryMenu.map((ind) => (
                    <a href={ind.href} role="menuitem" class="mega-link flex flex-col rounded-[12px] px-4 py-3">
                      <span class="text-[14px] font-medium" style="color: var(--color-primary)">{ind.label}</span>
                      <span class="mt-0.5 text-[12.5px] leading-[1.5]" style="color: var(--color-secondary)">{ind.blurb}</span>
                    </a>
                  ))}
                </div>
                <div class="mt-2 flex items-center justify-between rounded-[12px] px-4 py-3" style="background: var(--color-surface-3)">
                  <span class="text-[12.5px]" style="color: var(--color-secondary)">Not listed? We work across industries.</span>
                  <a href="/industries" role="menuitem" class="text-[13px] font-medium" style="color: var(--color-lime-text)">All industries →</a>
                </div>
              </div>
            </div>
          )}
        </div>
      ))}
    </nav>

    <div class="flex items-center gap-2.5">
      <a
        href="/book-consultation"
        class="inline-flex h-9 items-center justify-center gap-2 rounded-full px-4 text-[13px] font-medium text-white transition-all duration-150 shadow-md"
        style="background: var(--color-violet)"
        onmouseover="this.style.background='var(--color-violet-dark)'"
        onmouseout="this.style.background='var(--color-violet)'"
      >
      Contact us
      </a>

      <details class="relative md:hidden">
        <summary
          class="flex h-9 cursor-pointer list-none items-center rounded-full px-3 text-[13px] font-medium [&::-webkit-details-marker]:hidden"
          style="border: 1px solid var(--color-line-mid); color: var(--color-primary)"
        >
          Menu
        </summary>
        <nav
          aria-label="Mobile"
          class="absolute right-0 mt-3 max-h-[75vh] w-64 overflow-y-auto rounded-[16px] p-2 shadow-2xl backdrop-blur-lg"
          style="border: 1px solid var(--color-line-mid); background: var(--color-surface-2)"
        >
          <ul class="space-y-1">
            {nav.map((item) => (
              <li>
                <a
                  href={item.href}
                  class="block rounded-[8px] px-3 py-2 text-[14px] font-medium transition-colors"
                  style="color: var(--color-secondary)"
                  onmouseover="this.style.background='var(--color-surface-3)'; this.style.color='var(--color-primary)'"
                  onmouseout="this.style.background=''; this.style.color='var(--color-secondary)'"
                >
                  {item.label}
                </a>
                {'menu' in item && item.menu === 'services' && (
                  <ul class="mb-1 ml-3 border-l pl-2" style="border-color: var(--color-line)">
                    {serviceMenu.map((cat) => (
                      <li><a href={cat.href} class="block rounded-[8px] px-3 py-1.5 text-[13px]" style="color: var(--color-muted)">{cat.label}</a></li>
                    ))}
                  </ul>
                )}
                {'menu' in item && item.menu === 'industries' && (
                  <ul class="mb-1 ml-3 border-l pl-2" style="border-color: var(--color-line)">
                    {industryMenu.map((ind) => (
                      <li><a href={ind.href} class="block rounded-[8px] px-3 py-1.5 text-[13px]" style="color: var(--color-muted)">{ind.label}</a></li>
                    ))}
                  </ul>
                )}
              </li>
            ))}
          </ul>
        </nav>
      </details>
    </div>
  </div>
</header>

<style>
  /* Dropdown panels: open on hover or keyboard focus, no JS needed */
  .mega-panel {
    position: absolute;
    left: 0;
    right: 0;
    top: 100%;
    padding-top: 12px; /* invisible bridge so the menu doesn't close while the cursor travels down */
    opacity: 0;
    visibility: hidden;
    transform: translateY(6px);
    transition: opacity 160ms ease, transform 160ms ease, visibility 160ms;
    pointer-events: none;
  }
  .nav-item:hover .mega-panel,
  .nav-item:focus-within .mega-panel {
    opacity: 1;
    visibility: visible;
    transform: translateY(0);
    pointer-events: auto;
  }
  .mega-card {
    border-radius: 22px;
    padding: 10px;
    background: var(--color-surface-2);
    border: 1px solid var(--color-line-mid);
    box-shadow: 0 24px 60px -20px rgba(0, 0, 0, 0.45);
    backdrop-filter: blur(14px);
  }
  .mega-card-narrow {
    width: 360px;
    margin-left: auto;
    margin-right: auto;
  }
  .mega-link {
    transition: background-color 150ms ease;
  }
  .mega-link:hover,
  .mega-link:focus-visible {
    background: var(--color-surface-3);
  }
</style>
