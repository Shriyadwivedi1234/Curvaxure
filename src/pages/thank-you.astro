---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Button from '@/components/ui/Button.astro';
import { booking } from '@/config/booking';

const hasCal = !booking.calUrl.includes('YOUR-USERNAME');
---
<BaseLayout title="Thank you" noindex>
  <section class="container-page py-20 md:py-28">
    <div class="mx-auto max-w-[42em] text-center">
      <p class="eyebrow">Request received</p>
      <h1 class="mt-4 text-[clamp(38px,5vw,56px)]">Thanks, we've got your request</h1>
      <p class="mx-auto mt-5 max-w-[34em] text-[17px] leading-[1.7] text-slate">
        Pick a time for your free {booking.callMinutes}-minute call. We'll talk about your
        data and what you need to decide, then recommend where we can help and share pricing.
      </p>
    </div>

    <div class="mx-auto mt-10 max-w-[52em]">
      {hasCal ? (
        <iframe
          src={`${booking.calUrl}?embed=true`}
          title="Choose a time for your call"
          loading="lazy"
          class="h-[700px] w-full rounded-[16px] border border-line bg-paper-2"
        ></iframe>
      ) : (
        <p class="rounded-[16px] border border-line bg-paper-2 p-6 text-center text-[15px] text-slate">
          The calendar is being set up. We'll email you shortly to arrange a time.
        </p>
      )}
      <p class="mt-6 text-center text-[13px] text-slate">
        No need to send files or confidential data before the call.
      </p>
      <div class="mt-8 text-center">
        <Button href="/" variant="secondary">Back to home</Button>
      </div>
    </div>
  </section>
</BaseLayout>
