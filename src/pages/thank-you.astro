---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { booking } from '@/config/booking';

const hasCal = !booking.calUrl.includes('YOUR-USERNAME');
---
<BaseLayout title="Thank you" noindex>
  <section class="container-page py-20 md:py-28">
    <div class="mx-auto max-w-[42em] text-center">
      <div class="inline-flex items-center gap-2 rounded-full px-3 py-1 text-[11px] font-mono tracking-wider uppercase mb-4" style="border: 1px solid var(--color-line-mid); background: var(--color-surface-2); color: var(--color-lime)">
        <span>REQUEST RECEIVED</span>
      </div>
      <h1 class="text-[clamp(38px,5vw,56px)] font-medium text-white">Thanks, we've got your request</h1>
      <p class="mx-auto mt-5 max-w-[34em] text-[17px] leading-[1.7]" style="color: var(--color-secondary)">
        Pick a time for your free {booking.callMinutes}-minute growth strategy session. We'll examine your current curve, pinpoint bottlenecks, and share high-leverage moves.
      </p>
    </div>

    <div class="mx-auto mt-10 max-w-[52em]">
      {hasCal ? (
        <iframe
          src={`${booking.calUrl}?embed=true`}
          title="Choose a time for your call"
          loading="lazy"
          class="h-[700px] w-full rounded-[16px]"
          style="border: 1px solid var(--color-line); background: var(--color-surface-2)"
        ></iframe>
      ) : (
        <p class="rounded-[16px] p-6 text-center text-[15px]" style="border: 1px solid var(--color-line); background: var(--color-surface-2); color: var(--color-secondary)">
          The calendar integration is being finalized. We will email you directly within 24 hours to schedule your session.
        </p>
      )}
      <p class="mt-6 text-center text-[13px]" style="color: var(--color-muted)">
        No need to send files or confidential data before the call.
      </p>
      <div class="mt-8 text-center">
        <a href="/" class="btn btn-secondary">Back to home</a>
      </div>
    </div>
  </section>
</BaseLayout>
