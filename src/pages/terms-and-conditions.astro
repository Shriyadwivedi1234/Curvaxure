---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { site } from '@/config/site';
---
<BaseLayout
  title="Terms and conditions"
  description="The terms that apply to this website and the sample material shown on it."
>
  <section class="container-page py-16 md:py-24">
    <div class="max-w-[46em]">
      <p class="eyebrow">Legal</p>
      <h1 class="mt-4 text-[clamp(36px,4.6vw,52px)]">Terms and conditions</h1>
      <p class="mt-4 text-[13px] text-slate">Last updated 5 November 2026</p>

      <div class="mt-10 space-y-8 text-[15px] leading-[1.7]">
        <section>
          <h2 class="text-[20px]">Using this site</h2>
          <p class="mt-3 text-slate">
            This site describes Curvaxure's data analytics and dashboard services. You may
            use it for lawful, informational purposes. Do not attempt to disrupt the site or
            misuse the enquiry form.
          </p>
        </section>

        <section>
          <h2 class="text-[20px]">Samples and estimates</h2>
          <p class="mt-3 text-slate">
            Dashboards, figures and scenarios shown on this site are illustrative and use
            dummy data. They are not client results, guarantees or advice. Any estimate or
            recommendation depends on the data and scope we agree with you.
          </p>
        </section>

        <section>
          <h2 class="text-[20px]">Engagements</h2>
          <p class="mt-3 text-slate">
            Any work we do together is governed by a separate written agreement. Nothing on
            this site creates a contract or an obligation to provide services.
          </p>
        </section>

        <section>
          <h2 class="text-[20px]">Trademarks</h2>
          <p class="mt-3 text-slate">
            Microsoft, Power BI and Excel are trademarks of Microsoft. Curvaxure is
            independent and is not endorsed by Microsoft.
          </p>
        </section>

        <section>
          <h2 class="text-[20px]">Changes</h2>
          <p class="mt-3 text-slate">
            We may update these terms. The date above shows the latest version.
          </p>
        </section>
      </div>

      <p class="mt-10 border-t border-line pt-6 text-[13px] text-slate">
        Questions about these terms? Email
        <a href={`mailto:${site.contactEmail}`} class="text-ink underline underline-offset-2">{site.contactEmail}</a>.
      </p>
    </div>
  </section>
</BaseLayout>
