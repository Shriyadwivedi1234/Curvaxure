---
import BaseLayout from '@/layouts/BaseLayout.astro';
import ServiceHero from '@/components/service/ServiceHero.astro';
import SectionHead from '@/components/service/SectionHead.astro';
import Faq from '@/components/service/Faq.astro';
import CtaBand from '@/components/service/CtaBand.astro';
import { industries, getIndustry } from '@/config/industries';

export function getStaticPaths() {
  return industries.map((i) => ({ params: { slug: i.slug } }));
}
const { slug } = Astro.params;
const ind = getIndustry(slug as string)!;
const others = industries.filter((i) => i.slug !== ind.slug);
---
<BaseLayout
  title={`${ind.name}: growth systems`}
  description={`${ind.summary}`}
>
  <ServiceHero
    eyebrow={`Industries · ${ind.name}`}
    title={ind.hero.title}
    highlight={ind.hero.highlight}
    description={ind.hero.description}
    chips={ind.audience}
    source={`industry-${ind.slug}`}
    workHref="#pain"
    secondaryLabel="See where it hurts"
  />

  <section id="pain" class="py-20 md:py-28" style="border-top: 1px solid var(--color-line); background: var(--color-surface)">
    <div class="container-page">
      <SectionHead eyebrow="Sound familiar?" title={ind.question} intro={ind.summary} />
      <div class="mt-12 grid gap-4 md:grid-cols-2 lg:grid-cols-3">
        {ind.pains.map((p, i) => (
          <article class="hover-card rounded-[20px] p-6" style="border: 1px solid var(--color-line); background: var(--color-surface-2)">
            <span class="font-mono text-[12px] tabular-nums" style="color: var(--color-negative)">{String(i + 1).padStart(2, '0')}</span>
            <h3 class="mt-4 text-[21px] font-medium leading-[1.2]" style="color: var(--color-primary)">{p.t}</h3>
            <p class="mt-2 text-[14px] leading-[1.65]" style="color: var(--color-secondary)">{p.d}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section id="gap" class="py-20 md:py-28" style="border-top: 1px solid var(--color-line); background: var(--color-surface-2)">
    <div class="container-page">
      <SectionHead
        eyebrow="The gap"
        title="What staying behind looks like, and what changes."
        intro="Each service below fills a specific gap in your business. Together they remove the leaks between them."
      />
      <div class="mt-12 space-y-4">
        {ind.gap.map((g) => (
          <article class="grid gap-4 rounded-[22px] p-4 md:grid-cols-[minmax(0,2fr)_minmax(0,5fr)_minmax(0,5fr)] md:p-5" style="border: 1px solid var(--color-line); background: var(--color-surface-3)">
            <div class="flex items-center">
              <a href={g.href} class="text-[20px] font-medium transition-colors hover:text-[var(--color-violet)]" style="color: var(--color-primary)">{g.service} →</a>
            </div>
            <div class="rounded-[16px] p-4" style="background: var(--color-surface-2); border: 1px solid var(--color-line)">
              <p class="font-mono text-[11px] uppercase tracking-wider" style="color: var(--color-negative)">Without it</p>
              <p class="mt-2 text-[14px] leading-[1.65]" style="color: var(--color-secondary)">{g.without}</p>
            </div>
            <div class="rounded-[16px] p-4" style="background: var(--color-surface-2); border: 1px solid color-mix(in srgb, var(--color-lime) 40%, transparent)">
              <p class="font-mono text-[11px] uppercase tracking-wider" style="color: var(--color-lime-text)">With Curvaxure</p>
              <p class="mt-2 text-[14px] leading-[1.65]" style="color: var(--color-primary)">{g.withUs}</p>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="py-20 md:py-28" style="border-top: 1px solid var(--color-line); background: var(--color-surface)">
    <div class="container-page">
      <SectionHead
        eyebrow="Your funnel"
        title={`One connected funnel for ${ind.name.toLowerCase()}.`}
        intro="Every stage feeds the next, and every result flows back into your data so each round gets smarter."
      />
      <ol class="mt-12 grid gap-3 md:grid-cols-5">
        {ind.funnel.map((f, i) => (
          <li class="relative rounded-[18px] p-5" style="border: 1px solid var(--color-line); background: var(--color-surface-2)">
            <span class="font-mono text-[12px] tabular-nums" style="color: var(--color-lime-text)">{String(i + 1).padStart(2, '0')}</span>
            <h3 class="mt-3 text-[19px] font-medium" style="color: var(--color-primary)">{f.stage}</h3>
            <p class="mt-1.5 text-[13px] leading-[1.6]" style="color: var(--color-secondary)">{f.d}</p>
            {i < ind.funnel.length - 1 && <span aria-hidden="true" class="absolute -right-[14px] top-1/2 z-10 hidden -translate-y-1/2 text-[16px] md:block" style="color: var(--color-violet)">→</span>}
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="py-20 md:py-28" style="border-top: 1px solid var(--color-line); background: var(--color-surface-2)">
    <div class="container-page">
      <SectionHead
        eyebrow="Metrics that matter"
        title="The numbers we help you see."
        intro="We set these up as live dashboards, so decisions rest on data instead of guesswork. No figures are promised; we show you yours."
      />
      <div class="mt-12 grid gap-4 md:grid-cols-2 lg:grid-cols-3">
        {ind.metrics.map((m) => (
          <article class="hover-card rounded-[20px] p-6" style="border: 1px solid var(--color-line); background: var(--color-surface-3)">
            <h3 class="text-[19px] font-medium leading-[1.25]" style="color: var(--color-primary)">{m.name}</h3>
            <div class="mt-4 flex h-8 items-end gap-1.5" aria-hidden="true">
              {[35, 55, 45, 70, 60, 85].map((h, i) => (
                <span class="w-full rounded-t-[3px]" style={`height:${h}%; background: ${i === 5 ? 'var(--color-lime)' : 'var(--color-line-mid)'}`}></span>
              ))}
            </div>
            <p class="mt-4 text-[13.5px] leading-[1.6]" style="color: var(--color-secondary)">{m.why}</p>
          </article>
        ))}
      </div>
      <p class="mt-6 text-[12px]" style="color: var(--color-muted)">The small charts are decorative, not real data.</p>
    </div>
  </section>

  <section class="py-20 md:py-28" style="border-top: 1px solid var(--color-line); background: var(--color-surface)">
    <div class="container-page grid gap-8 lg:grid-cols-[minmax(0,6fr)_minmax(0,5fr)]">
      <div>
        <SectionHead eyebrow="What you gain" title="The advantages, in plain terms." />
        <div class="mt-10 grid gap-3 sm:grid-cols-2">
          {ind.advantages.map((a) => (
            <div class="rounded-[18px] p-5" style="border: 1px solid var(--color-line); background: var(--color-surface-2)">
              <h3 class="text-[17px] font-medium" style="color: var(--color-primary)">{a.t}</h3>
              <p class="mt-1.5 text-[13.5px] leading-[1.6]" style="color: var(--color-secondary)">{a.d}</p>
            </div>
          ))}
        </div>
      </div>
      <aside class="self-end rounded-[24px] p-6 md:p-8" style="background: var(--color-violet)">
        <p class="font-mono text-[11px] uppercase tracking-wider" style="color: rgba(255,255,255,0.7)">Where we would begin</p>
        <h3 class="mt-3 text-[24px] font-medium leading-[1.15]" style="color: #fff">{ind.start.title}</h3>
        <ul class="mt-5 space-y-3">
          {ind.start.items.map((t) => (
            <li class="flex items-start gap-3 text-[14px] leading-[1.5]" style="color: #fff">
              <span class="mt-[7px] h-1.5 w-1.5 flex-none rounded-full" style="background: var(--color-lime)"></span>{t}
            </li>
          ))}
        </ul>
        <a href={`/book-consultation?industry=${ind.slug}&source=industry-${ind.slug}`} class="btn btn-lime mt-7 w-full">Plan this with us →</a>
      </aside>
    </div>
  </section>

  <Faq items={ind.faqs} />

  <section class="py-16" style="border-top: 1px solid var(--color-line); background: var(--color-surface-2)">
    <div class="container-page">
      <p class="font-mono text-[12px] uppercase tracking-wider" style="color: var(--color-muted)">Other industries</p>
      <div class="mt-4 flex flex-wrap gap-2">
        {others.map((o) => (
          <a href={`/industries/${o.slug}`} class="rounded-full px-4 py-2 text-[13px] font-medium transition-colors hover:text-[var(--color-lime-text)]" style="border: 1px solid var(--color-line-mid); background: var(--color-surface-3); color: var(--color-primary)">{o.name} →</a>
        ))}
      </div>
    </div>
  </section>

  <CtaBand
    title={`Ready to fix the leaks in your ${ind.name.toLowerCase()} funnel?`}
    text="Book a free growth call. We will map where enquiries, money and time are slipping away, and what to fix first."
    source={`industry-${ind.slug}-cta`}
  />
</BaseLayout>

<style>
  .hover-card { transition: transform 250ms ease, border-color 250ms ease, box-shadow 250ms ease; }
  .hover-card:hover {
    transform: translateY(-3px);
    border-color: color-mix(in srgb, var(--color-violet) 40%, transparent) !important;
    box-shadow: 0 14px 32px -18px color-mix(in srgb, var(--color-violet) 55%, transparent);
  }
</style>
