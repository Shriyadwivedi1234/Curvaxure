---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { booking, industries, focusAreas } from '@/config/booking';

const siteKey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY;
const field = 'field';
const label = 'mb-1.5 block text-[13px] font-medium text-white/90';
const steps = [
  'We map how your business currently acquires customers and manages data.',
  'We identify what is bending your growth curve and where friction lives.',
  'We recommend an exact strategic sequence across search, marketing, data, or automation.',
];
---
<BaseLayout
  title="Book a growth call"
  description="A free, no-obligation conversation about your growth curve, operational friction, and key levers for expansion."
>
  <section class="container-page grid gap-12 py-16 lg:grid-cols-[minmax(0,5fr)_minmax(0,6fr)] lg:gap-16 lg:py-24">
    <div>
      <div class="inline-flex items-center gap-2 rounded-full px-3 py-1 text-[11px] font-mono tracking-wider uppercase mb-4" style="border: 1px solid var(--color-line-mid); background: var(--color-surface-2); color: var(--color-lime)">
        <span>FREE · {booking.callMinutes} MINUTES · NO OBLIGATION</span>
      </div>
      <h1 class="text-[clamp(38px,4.8vw,56px)] font-medium text-white">Book a growth call</h1>
      <p class="mt-5 max-w-[30em] text-[17px] leading-[1.65]" style="color: var(--color-secondary)">
        Tell us about your business and where you want to take your curve next.
      </p>

      <h2 class="mt-10 text-[20px] font-medium text-white">What happens on the call</h2>
      <ol class="mt-4 divide-y" style="border-color: var(--color-line); border-top: 1px solid var(--color-line); border-bottom: 1px solid var(--color-line)">
        {steps.map((step, index) => (
          <li class="grid grid-cols-[32px_1fr] gap-4 py-4" style="border-color: var(--color-line)">
            <span class="text-[12px] font-mono font-medium tabular-nums" style="color: var(--color-lime)">
              {String(index + 1).padStart(2, '0')}
            </span>
            <span class="text-[15px] leading-[1.65]" style="color: var(--color-primary)">{step}</span>
          </li>
        ))}
      </ol>

      <p class="mt-5 text-[13px] leading-[1.6]" style="color: var(--color-muted)">
        No high-pressure sales. Just an honest evaluation of what's working and what's holding you back.
      </p>
    </div>

    <form
      method="post"
      action="/api/lead"
      class="h-fit rounded-[20px] p-6 md:p-8"
      style="border: 1px solid var(--color-line); background: var(--color-surface-2)"
    >
      <p id="form-error" role="alert" hidden class="mb-4 rounded-[8px] px-4 py-3 text-[13px]" style="background: rgba(229, 72, 77, 0.15); color: var(--color-negative)"></p>

      <div class="grid gap-4 sm:grid-cols-2">
        <div>
          <label class={label} for="name">Name</label>
          <input class={field} id="name" name="name" required minlength="2" maxlength="120" autocomplete="name" />
        </div>
        <div>
          <label class={label} for="email">Work email</label>
          <input class={field} id="email" name="email" type="email" required maxlength="200" autocomplete="email" />
        </div>
        <div>
          <label class={label} for="company">Company</label>
          <input class={field} id="company" name="company" required minlength="2" maxlength="160" autocomplete="organization" />
        </div>
        <div>
          <label class={label} for="industry">Industry</label>
          <select class={field} id="industry" name="industry" required>
            <option value="" disabled selected>Select</option>
            {industries.map((industry) => <option value={industry.value}>{industry.label}</option>)}
          </select>
        </div>
        <div class="sm:col-span-2">
          <label class={label} for="focus">Primary growth objective?</label>
          <select class={field} id="focus" name="focus" required>
            <option value="" disabled selected>Select</option>
            {focusAreas.map((area) => <option value={area.value}>{area.label}</option>)}
          </select>
        </div>
        <div class="sm:col-span-2">
          <label class={label} for="message">
            Anything else we should know? <span class="font-normal" style="color: var(--color-muted)">(optional)</span>
          </label>
          <textarea class={field} id="message" name="message" rows="3" maxlength="2000"></textarea>
        </div>
      </div>

      <input type="hidden" name="source" id="source" />
      <input type="hidden" name="plan" id="plan" />
      <div class="absolute -left-[9999px]" aria-hidden="true">
        <label>Website <input name="website" tabindex="-1" autocomplete="off" /></label>
      </div>
      {siteKey && <div class="cf-turnstile mt-4" data-sitekey={siteKey}></div>}
      {siteKey && <script src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer is:inline></script>}

      <button type="submit" class="btn btn-lime mt-6 w-full shadow-lg">Request my growth call</button>
      <p class="mt-3 text-[12px] leading-[1.6]" style="color: var(--color-muted)">
        We'll reach out within 24 hours to schedule your session. See our <a href="/privacy-policy" class="underline underline-offset-2 hover:text-white">Privacy Policy</a>.
      </p>
    </form>
  </section>
</BaseLayout>

<script>
  const query = new URLSearchParams(location.search);
  const set = (id: string, value: string | null) => {
    const element = document.getElementById(id) as HTMLInputElement | HTMLSelectElement | null;
    if (element && value) element.value = value;
  };
  set('source', query.get('source'));
  set('plan', query.get('plan'));
  set('focus', query.get('focus'));
  set('industry', query.get('industry'));

  const messages: Record<string, string> = {
    invalid: 'Please check the form. Name, work email, company, industry and focus are required.',
    spam: 'We could not verify the spam check. Please try again.',
    server: 'Something went wrong on our side. Please try again in a moment.',
  };
  const error = query.get('error');
  const box = document.getElementById('form-error');
  if (error && box && messages[error]) {
    box.textContent = messages[error];
    box.hidden = false;
  }
</script>
