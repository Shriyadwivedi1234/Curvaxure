# Copy to .env for local use; add the same names in Vercel > Settings > Environment Variables.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
RESEND_API_KEY=
NOTIFY_EMAIL=you@yourcompany.com
FROM_EMAIL=Curvaxure <hello@yourdomain.com>
# Optional spam protection (Cloudflare Turnstile)
PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Copy to .env for local use; add the same names in Vercel > Settings > Environment Variables.
# Email (always on)
RESEND_API_KEY=
NOTIFY_EMAIL=you@yourcompany.com
FROM_EMAIL=Curvaxure <hello@yourdomain.com>

# Zoho CRM (optional). India data centre shown; change if your account is elsewhere.
ZOHO_ACCOUNTS_URL=https://accounts.zoho.in
ZOHO_API_URL=https://www.zohoapis.in
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REFRESH_TOKEN=

# Google Sheet via Apps Script (optional)
SHEETS_WEBHOOK_URL=
SHEETS_SECRET=

# Spam protection (optional, Cloudflare Turnstile)
PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
